<title>Malawi Directly | Find Businesses Across Malawi</title>
<style>
:root{--bg:#101010;--panel:#1c1c1c;--gold:#f5c400;--muted:#bdbdbd;--line:#554600;--green:#168b48}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:#fff;font-family:Arial,sans-serif;line-height:1.5}
header{background:#080808;border-bottom:2px solid var(--gold);padding:18px 4%;position:sticky;top:0;z-index:5}
.top{max-width:1150px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}
.brand{font-weight:900;color:var(--gold);font-size:23px;text-decoration:none}.tag{color:#ccc;font-size:12px}
nav{display:flex;gap:13px;flex-wrap:wrap}nav a{color:#fff;text-decoration:none;font-size:14px}nav a:hover{color:var(--gold)}
.hero{text-align:center;padding:55px 15px;background:linear-gradient(130deg,#171717,#302600)}.hero h1{color:var(--gold);font-size:clamp(28px,5vw,45px);margin:0 0 10px}.hero p{max-width:650px;margin:0 auto 22px;color:#ddd}
.container{width:min(1150px,94%);margin:auto}section{padding:32px 0}.title{text-align:center;color:var(--gold);font-size:26px;margin:0 0 20px}
button,.btn{border:0;border-radius:7px;padding:12px 15px;font-weight:bold;cursor:pointer;text-decoration:none;display:inline-block;text-align:center}
button:disabled{opacity:.6;cursor:wait}.primary{background:var(--gold);color:#111}.secondary{background:#333;color:#fff;border:1px solid #777}.green{background:var(--green);color:white}.danger{background:#b52c2c;color:white}
input,select,textarea{width:100%;padding:13px;border:1px solid #555;border-radius:7px;background:#222;color:#fff;font:inherit;margin:5px 0 12px}
label{display:block;color:var(--gold);font-weight:bold;margin-top:7px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:11px}
.cat{background:#202020;color:#fff;border:1px solid var(--gold);min-height:58px}.cat:hover{background:#5b4900}
.searchgrid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:10px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}
.card,.box{background:var(--panel);border:1px solid var(--line);border-radius:11px;padding:16px}
.card h3{color:var(--gold);margin:8px 0}.card p{margin:5px 0;overflow-wrap:anywhere}
.badge{display:inline-block;background:var(--gold);color:#111;padding:4px 8px;border-radius:4px;font-size:12px;font-weight:bold;margin-bottom:7px}
.actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.actions>*{flex:1;min-width:90px;font-size:13px}
.form{max-width:760px;margin:auto}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.small{font-size:12px;color:var(--muted)}.notice{padding:12px;border-left:3px solid var(--gold);background:#24200f;color:#eee;border-radius:5px;margin:12px 0}
.adminrow{border:1px solid #555;border-radius:7px;padding:12px;margin:10px 0;background:#222}
.adminrow button{margin:4px}.status{padding:10px;border-radius:6px;background:#242424;color:#eee;margin:10px 0}
footer{background:#080808;border-top:2px solid var(--gold);padding:25px;text-align:center;color:#ccc;margin-top:30px}
.hidden{display:none!important}.empty{text-align:center;color:#bbb;padding:25px}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}.stat{background:#252525;padding:15px;border-radius:8px;text-align:center}.stat strong{display:block;color:var(--gold);font-size:24px}
@media(max-width:650px){.searchgrid,.two{grid-template-columns:1fr}.top{justify-content:center}nav{justify-content:center}.hero{padding:40px 12px}}
</style>
</head>
<body>
<header><div class="top">
