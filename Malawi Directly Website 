 <div class="two"><div><label>Category *</label><select id="businessCategory" required><option value="">Choose category</option><option value="Restaurants">Restaurants</option><option value="Hotels & Lodges">Hotels & Lodges</option><option value="Clothing & Fashion">Clothing & Fashion</option><option value="Beauty Salons">Beauty Salons</option><option value="Barbershops">Barbershops</option><option value="Electronics">Electronics</option><option value="Phone & Computer Repair">Phone & Computer Repair</option><option value="Construction">Construction</option><option value="Hardware & Building Materials">Hardware & Building Materials</option><option value="Transport">Transport</option><option value="Car Hire">Car Hire</option><option value="Pharmacies">Pharmacies</option><option value="Hospitals & Clinics">Hospitals & Clinics</option><option value="Schools & Colleges">Schools & Colleges</option><option value="Agriculture">Agriculture</option><option value="Farms & Agro-dealers">Farms & Agro-dealers</option><option value="Real Estate">Real Estate</option><option value="Shops & Supermarkets">Shops & Supermarkets</option><option value="Photography & Video">Photography & Video</option><option value="Printing & Branding">Printing & Branding</option><option value="Cleaning Services">Cleaning Services</option><option value="Delivery Services">Delivery Services</option><option value="Events & Entertainment">Events & Entertainment</option><option value="Financial Services">Financial Services</option><option value="Legal Services">Legal Services</option><option value="Fitness & Sports">Fitness & Sports</option><option value="Tourism">Tourism</option><option value="Mechanics & Garages">Mechanics & Garages</option><option value="Plumbing & Electrical">Plumbing & Electrical</option><option value="General Services">General Services</option></select></div><div><label>District *</label><select id="businessDistrict" required><option value="">Choose district</option><option value="Bala